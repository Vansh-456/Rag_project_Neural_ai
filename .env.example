# Copy to .env and fill in. Never commit .env.
# --- LLM providers (all optional; without keys the extractive generator + rule extractor run) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Select a provider/model for generation without editing YAML:
# AGVRAG__GENERATION__PROVIDER=anthropic
# AGVRAG__GENERATION__MODEL=claude-opus-5-5
# --- Graph database (docker compose / production config) ---
NEO4J_PASSWORD=change-me-neo4j
# --- API basic auth (required when api.auth_enabled, i.e. production) ---
API_USERNAME=admin
API_PASSWORD=change-me-api
# --- Optional UI basic auth ---
UI_BASIC_AUTH_USER=
UI_BASIC_AUTH_PASSWORD=
# --- Config selection ---
# AGVRAG_CONFIG=base            # default config for CLI/API
# AGVRAG_ENV=production         # layers configs/production.yaml on top
AUTO_BOOTSTRAP=true
