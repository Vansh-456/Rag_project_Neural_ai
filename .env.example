# Environment configuration for Adaptive Graph + Vector RAG

# App Settings
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Vector Store (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_corpus
QDRANT_IN_MEMORY=false

# Graph Store (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=adaptive_rag_password
NEO4J_IN_MEMORY=true

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=data/cache/embeddings

# Reranker Model
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

# LLM Providers (Configure at least one for live generation or leave blank for deterministic mock client)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
DEFAULT_LLM_PROVIDER=mock

# Budget and Cost Settings
MAX_RETRIEVAL_CALLS=5
MAX_GRAPH_HOPS=3
MAX_CANDIDATE_POOL=50
MAX_LATENCY_MS=5000
MAX_TOKEN_BUDGET=4096
COST_PER_1K_PROMPT_TOKENS=0.00015
COST_PER_1K_COMPLETION_TOKENS=0.0006
