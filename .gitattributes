# Normalize text to LF in the repo. Shell scripts must stay LF in the working tree too:
# a Windows checkout with core.autocrlf=true would otherwise copy a CRLF entrypoint.sh into
# the Linux container and fail with "/usr/bin/env: 'sh\r': No such file or directory".
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
# Binary artifacts
*.pdf binary
*.png binary
*.sqlite binary
